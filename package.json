{
	"name": "NoteClassifier",
	"version": "0.3.2",
	"description": "NoteClassifier allows you to define classes for your notes, and based on that, assign required frontmatter, move to specified folders, and manage classifications",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "jest"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jest": "^30.5.2",
		"jest-environment-obsidian": "^0.0.1",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"ts-jest": "^29.4.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
